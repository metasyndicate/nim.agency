{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nim.agency/schema/meta/agency.metaschema.json",
  "title": "NIM Agency Metaschema",
  "description": "Base definitions and common patterns for biomimetic agent fleet management",
  "@type": ["nim:Metaschema", "skos:ConceptScheme"],
  "@context": {
    "nim": "https://nim.agency/ns#",
    "fipa": "http://www.fipa.org/specs/fipa00023#",
    "prov": "http://www.w3.org/ns/prov#",
    "sosa": "http://www.w3.org/ns/sosa/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "sh": "http://www.w3.org/ns/shacl#",
    "process": "http://www.daml.org/services/owl-s/1.1/Process.owl#",
    "profile": "http://www.daml.org/services/owl-s/1.1/Profile.owl#"
  },
  "$nim.meta": {
    "nim.id": 400000,
    "created": "2026-04-06T00:00:00Z",
    "modified": "2026-04-06T00:00:00Z",
    "version": "1.0.0",
    "layer": {
      "id": 0,
      "label": "meta",
      "component": "agency",
      "object": "metaschema",
      "type": "schema",
      "path": "L0.agency.metaschema"
    },
    "agent": {
      "type": "system",
      "name": "nim.agency",
      "version": "1.0.0"
    },
    "summary": "Biomimetic agent fleet management - core schema definitions"
  },
  "$defs": {
    "x-nim-ref": {
      "type": "object",
      "description": "Shape of the x-nim-ref annotation keyword: the annotated value (or each array item, or each object key under propertyNames) is a key of another entity - the agency's foreign key. Checked by lib/data/refs.py and `nim.agency data check`; standard validators ignore it. Meaning follows SHACL sh:class and LinkML slot range; x- prefixed because JSON Schema 2020-12 reserves $ keywords for its core.",
      "$comment": "rdf:property sh:class",
      "properties": {
        "entity": {
          "type": "string",
          "description": "Target entity name as registered in the datastore (lib/data/crud.py ENTITY_CONFIG)"
        },
        "key": {
          "type": "string",
          "default": "id",
          "description": "Target field the value must equal: id (surrogate), slug (skos:notation), or another unique field such as function_name"
        },
        "within": {
          "type": "object",
          "description": "Dependent bound: the value must also be listed in `field` of the record that the (declared) reference at `via` points to. A syndicate channel's capabilities are bounded by its transport's capability_ceiling this way. Forms offer only the bounded values; data check enforces the bound.",
          "properties": {
            "via": { "type": "string", "description": "JSON Pointer (RFC 6901) from the record root to a field that itself carries x-nim-ref" },
            "field": { "type": "string", "description": "Array field on the referenced record listing the allowed keys" }
          },
          "required": ["via", "field"],
          "additionalProperties": false
        },
        "where": {
          "type": "object",
          "description": "Only target records whose fields take one of the listed values qualify, e.g. {\"decision\": [\"allow\", \"ask\"]} so a profile cannot name a denied command. Forms offer only qualifying records; data check enforces it.",
          "additionalProperties": { "type": "array", "items": { "type": ["string", "number", "boolean"] }, "minItems": 1 }
        }
      },
      "required": ["entity", "key"],
      "additionalProperties": false
    },
    "tool_annotations": {
      "type": "object",
      "description": "Behaviour hints for something a model can invoke, after the Model Context Protocol ToolAnnotations (spec 2026-07-28). Hints describe; the agency harness enforces - never the reverse.",
      "$comment": "MCP ToolAnnotations",
      "properties": {
        "readOnlyHint": { "type": "boolean", "default": false, "description": "Does not modify its environment" },
        "destructiveHint": { "type": "boolean", "default": true, "description": "May perform destructive updates (meaningful only when not read-only)" },
        "idempotentHint": { "type": "boolean", "default": false, "description": "Repeating it with the same arguments has no further effect" },
        "openWorldHint": { "type": "boolean", "default": true, "description": "Interacts with entities outside a closed domain (network, other hosts)" }
      },
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "RFC 4122 UUID v4 identifier",
      "$comment": "rdf:property dcterms:identifier"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 2,
      "maxLength": 64,
      "description": "URL-safe identifier slug",
      "$comment": "rdf:property skos:notation"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp",
      "$comment": "rdf:property xsd:dateTime"
    },
    "percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage value (0-100)"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Five-star rating scale"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5,
      "description": "Priority scale (1=critical, 10=low)"
    },
    "provenance": {
      "type": "object",
      "description": "Origin/creation metadata (prov:wasGeneratedBy)",
      "$comment": "rdf:type prov:Generation",
      "properties": {
        "operator": {
          "type": "string",
          "maxLength": 128,
          "description": "Spawning operator username",
          "$comment": "rdf:property prov:wasAssociatedWith"
        },
        "host": {
          "type": "string",
          "maxLength": 256,
          "description": "Spawning host/IP address",
          "$comment": "rdf:property prov:atLocation"
        },
        "client": {
          "type": "string",
          "maxLength": 64,
          "description": "Interface type (cli, wui, api, scan)",
          "$comment": "rdf:property nim:originClient"
        },
        "discovery": {
          "type": "string",
          "enum": ["created", "scanned", "imported", "migrated", "drafted"],
          "default": "created",
          "description": "Discovery/creation method (drafted: recruited from the candidate pool, lib/data/roster.py)"
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp",
          "description": "Origin timestamp",
          "$comment": "rdf:property prov:atTime"
        },
        "provider": {
          "type": ["string", "null"],
          "description": "Agent model/service provider (anthropic, openai, etc.); null when not bound to one"
        },
        "model": {
          "type": ["object", "null"],
          "description": "Model binding; null when not bound to one",
          "properties": {
            "name": { "type": "string", "description": "Model name (opus, sonnet, gpt-4)" },
            "version": { "type": "string", "description": "Model version" }
          }
        }
      },
      "required": ["timestamp"]
    },
    "audit_timestamps": {
      "type": "object",
      "readOnly": true,
      "description": "Standard audit timestamp fields, maintained by the datastore (readOnly: composition interfaces do not set them)",
      "properties": {
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "$comment": "rdf:property dcterms:created"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp",
          "$comment": "rdf:property dcterms:modified"
        },
        "retired_at": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ],
          "description": "Retirement/archive timestamp"
        }
      },
      "required": ["created_at", "updated_at"]
    },
    "concept": {
      "type": "object",
      "description": "SKOS Concept - base for all lookup/reference entities",
      "$comment": "rdf:type skos:Concept",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "readOnly": true,
          "description": "Numeric identifier, assigned by the datastore (next free id)"
        },
        "slug": {
          "$ref": "#/$defs/slug",
          "description": "URL-safe unique identifier"
        },
        "label": {
          "type": "string",
          "maxLength": 128,
          "description": "Human-readable label",
          "$comment": "rdf:property skos:prefLabel"
        },
        "description": {
          "type": "string",
          "description": "Detailed description",
          "$comment": "rdf:property skos:definition"
        },
        "sort_order": {
          "type": "integer",
          "default": 0,
          "description": "Display ordering"
        }
      },
      "required": ["id", "slug", "label"]
    },
    "icon_ref": {
      "type": "string",
      "maxLength": 256,
      "description": "Icon reference - emoji, unicode symbol, or asset path",
      "examples": ["🎖", "⭐", "assets/badges/centurion.png"]
    },
    "rpg_economy": {
      "type": "object",
      "description": "RPG-style agent economy attributes",
      "$comment": "nim:AgentEconomy - gamification mechanics for engagement",
      "properties": {
        "health": {
          "type": "object",
          "properties": {
            "current": { "$ref": "#/$defs/percentage", "default": 100 },
            "max": { "$ref": "#/$defs/percentage", "default": 100 }
          },
          "required": ["current", "max"]
        },
        "xp": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Experience points (drives rank promotion)"
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Currency for agent economy"
        },
        "skill_points": {
          "type": "object",
          "properties": {
            "total": { "type": "integer", "minimum": 0, "default": 100 },
            "assigned": { "type": "integer", "minimum": 0, "default": 0 }
          },
          "required": ["total", "assigned"]
        }
      },
      "required": ["health", "xp", "gold", "skill_points"]
    },
    "ratings": {
      "type": "object",
      "description": "Dual-scoring reputation system",
      "properties": {
        "operator": {
          "type": "object",
          "description": "Operator/human ratings",
          "properties": {
            "sum": { "type": "integer", "minimum": 0, "default": 0 },
            "count": { "type": "integer", "minimum": 0, "default": 0 }
          }
        },
        "peer": {
          "type": "object",
          "description": "Agent-to-agent peer ratings",
          "properties": {
            "sum": { "type": "integer", "minimum": 0, "default": 0 },
            "count": { "type": "integer", "minimum": 0, "default": 0 }
          }
        },
        "missions_completed": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    }
  }
}
