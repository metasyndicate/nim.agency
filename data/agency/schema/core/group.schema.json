{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nim.agency/schema/core/group.schema.json",
  "title": "Agent Group",
  "description": "Crues - organizational groupings of agents, each classified by a crue_type",
  "@type": ["foaf:Group", "prov:Organization"],
  "$ref": "https://nim.agency/schema/meta/agency.metaschema.json",
  "$nim.meta": {
    "nim.id": 400103,
    "created": "2026-04-06T00:00:00Z",
    "modified": "2026-10-15T00:00:00Z",
    "version": "2.0.0",
    "layer": {
      "id": 3,
      "label": "data",
      "component": "agency",
      "subcomponent": "core",
      "object": "group",
      "type": "schema",
      "path": "L3.agency.core.group"
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "readOnly": true,
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/uuid"
    },
    "slug": {
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/slug"
    },
    "name": {
      "type": "string",
      "maxLength": 128
    },
    "crue_type_slug": {
      "x-nim-ref": {"entity": "crue_type", "key": "slug"},
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/slug",
      "description": "Classification of the group in the crue_type concept scheme (org:classification); the label, icon, and composition come from that row"
    },
    "description": {
      "type": "string"
    },
    "parent_id": {
      "oneOf": [
        { "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/uuid" },
        { "type": "null" }
      ],
      "description": "Parent group for hierarchy"
    },
    "specialization": {
      "type": "object",
      "description": "Group focus areas",
      "properties": {
        "domains": {
          "type": "array",
          "items": { "type": "integer", "x-nim-ref": {"entity": "skill_domain", "key": "id"} },
          "description": "Primary skill domain IDs"
        },
        "tools": {
          "type": "array",
          "items": { "type": "integer", "x-nim-ref": {"entity": "tool", "key": "id"} },
          "description": "Specialized tool IDs"
        },
        "mission_types": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capacity": {
      "type": "object",
      "properties": {
        "max_members": {
          "type": "integer",
          "minimum": 1
        },
        "current_members": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "icon": {
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/icon_ref"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "audit": {
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/audit_timestamps"
    }
  },
  "required": ["id", "slug", "name", "crue_type_slug"]
}
