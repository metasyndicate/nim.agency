{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nim.agency/schema/core/tool.schema.json",
  "title": "Agent Tool",
  "description": "Global tool catalog - agents assigned from this inventory",
  "@type": ["sosa:Actuator", "process:AtomicProcess"],
  "$ref": "https://nim.agency/schema/meta/agency.metaschema.json",
  "$nim.meta": {
    "nim.id": 400101,
    "created": "2026-04-06T00:00:00Z",
    "modified": "2026-04-06T00:00:00Z",
    "version": "1.0.0",
    "layer": {
      "id": 3,
      "label": "data",
      "component": "agency",
      "subcomponent": "core",
      "object": "tool",
      "type": "schema",
      "path": "L3.agency.core.tool"
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "readOnly": true,
      "description": "Numeric identifier, assigned by the datastore"
    },
    "slug": {
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/slug",
      "description": "Tool identifier (e.g., 'curl', 'ssh', 'git')"
    },
    "label": {
      "type": "string",
      "maxLength": 128,
      "description": "Display name"
    },
    "description": {
      "type": "string",
      "description": "Tool description and capabilities"
    },
    "category_id": {
      "x-nim-ref": {"entity": "tool_category", "key": "id"},
      "type": "integer",
      "minimum": 1,
      "description": "Reference to tool_category"
    },
    "usage": {
      "type": "object",
      "description": "Usage information",
      "properties": {
        "syntax": {
          "type": "string",
          "description": "Basic usage syntax"
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Usage examples"
        },
        "documentation_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "min_rank_id": {
          "x-nim-ref": {"entity": "rank", "key": "id"},
          "type": "integer",
          "description": "Minimum rank required to use"
        },
        "required_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain_id": { "type": "integer", "x-nim-ref": {"entity": "skill_domain", "key": "id"} },
              "min_points": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Display ordering (assigned on add, as for every reference table)"
    },
    "risk": {
      "type": "object",
      "description": "What running this tool can do to the host. Declared from the values in use; the per-invocation rules an agency harness enforces live in command_policy, not here.",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["safe", "moderate", "elevated", "high", "critical"],
          "description": "Severity tier, aligned with tool_category.risk_level"
        },
        "reversibility": {
          "type": "string",
          "enum": ["read_only", "reversible", "partially_reversible", "irreversible", "varies"]
        },
        "scope": {
          "type": "string",
          "enum": ["local", "remote", "distributed"],
          "description": "How far its effects reach"
        },
        "requires_confirmation": { "type": "boolean", "default": false },
        "dangerous_subcommands": { "type": "array", "items": { "type": "string" } },
        "dangerous_flags": { "type": "array", "items": { "type": "string" } },
        "dangerous_commands": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["level", "reversibility", "scope"]
    },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "description": "Gold an agent pays to equip it (lib/data/economy.py)"
    },
    "icon": {
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/icon_ref"
    },
    "audit": {
      "$ref": "https://nim.agency/schema/meta/agency.metaschema.json#/$defs/audit_timestamps"
    }
  },
  "required": ["id", "slug", "label", "category_id"]
}
