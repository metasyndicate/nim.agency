    {
      "id": 11,
      "slug": "stray",
      "label": "Agent file outside harness locations",
      "description": "Named like an instruction, agent, prompt, or skill file, but outside every folder a harness loads from: no harness reads it unless a loaded document points at it.",
      "patterns": [
        "**/*.instructions.md",
        "**/*.agent.md",
        "**/*.prompt.md",
        "**/SKILL.md"
