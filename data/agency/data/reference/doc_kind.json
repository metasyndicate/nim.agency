      "harness_slugs": [],
      "hub": false,
      "frontmatter": {},
      "max_bytes": null,
      "substrate_kinds": [
        "instruction",
        "directive",
        "skill",
        "prompt"
      ],
      "record": false,
      "verified": null,
      "sort_order": 11
