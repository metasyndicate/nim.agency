{
  "root": "/Volumes/mf-arc/ai/library",
  "formats": {
    "images": ["jpg", "jpeg", "png", "tif", "tiff", "heic", "webp", "bmp", "gif"],
    "text": ["txt", "md", "rtf", "docx", "odt", "pdf", "html"]
  },
  "ignore": [".DS_Store", "Thumbs.db", "desktop.ini"],
  "class": {"character": "person", "group": "band"},
  "init": {
    "_doc": "image settings for `init`. The image worker runs under `python` (needs Pillow + OpenCV); sd-scripts' venv has both.",
    "python": "/Volumes/mf-arc/ai/tools/sd-scripts/venv/bin/python",
    "max_side": 1024,
    "min_side": 384,
    "face_crop": true,
    "face_crop_scale": 3.0,
    "face_crop_min": 512,
    "caption": "{trigger} {class}",
    "caption_face": "{trigger} {class}, close-up portrait"
  },
  "keys": {
    "_doc": "--keys mapping. A key listed here fills a typed profile field; any other key goes to profile.attributes unchanged. Keys match case-insensitively.",
    "instrument": {"field": "roles", "as": "roleName"},
    "role": {"field": "roles", "as": "roleName"},
    "voice": {"field": "voiceType"},
    "class": {"field": "class"},
    "alias": {"field": "alternateName"},
    "aka": {"field": "alternateName"}
  },
  "terms": {
    "profile.character": "https://schema.org/Person",
    "profile.group": "https://schema.org/MusicGroup",
    "role": "https://schema.org/OrganizationRole",
    "role.roleName": "https://schema.org/roleName",
    "role.instrument": "https://schema.org/instrument",
    "group.members": "https://schema.org/member",
    "voiceType": "no benchmark; assumption: free-text voice classification (Tenor, Baritone, ...)",
    "item.image": "https://schema.org/ImageObject",
    "item.text": "https://schema.org/CreativeWork",
    "source": "http://www.w3.org/ns/prov#Entity",
    "activity": "http://www.w3.org/ns/prov#Activity",
    "trigger": "no benchmark; assumption: kohya/DreamBooth instance token"
  }
}
