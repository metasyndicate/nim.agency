# --- NIM Agency distribution policy -----------------------------------------
# Instance data is operator-local and never shipped: distributed operators
# populate their own agents/behaviors/profiles. Explicit (case-exact) rules -
# do not rely on the case-insensitive matches of the patterns above.
data/agency/data/agents/
data/agency/data/archive/
data/agency/data/groups/
data/agency/data/missions/
data/agency/data/transactions/

# Instance root coupling (.nim/work/plan.101526.instance.md): data/local is a
# link to this checkout's instance root (or, in project scope, the root itself);
# data/local.json is the pointer used where symlinks are unavailable.
data/local
data/local.json

# The depot vault holds live key material - never distributed, no exceptions.
data/agency/hive/depot/.vault/

# Schemas and shipped defaults are hard dependencies of the code - the schema
# determines the data. Re-include anything the generic patterns above caught.
!lib/cli/agent.py
!tui/views/agent_edit.py
!data/agency/schema/
!data/agency/schema/**
!data/agency/data/reference/
!data/agency/data/reference/*.json
!data/agency/data/instruction/
!data/agency/data/instruction/**

# Tracked seed fixtures (no key material - tests/test_seed.py enforces it).
# `agents` matches **/*AGENT* under case-insensitive git, so re-include.
!data/agency/seed/
!data/agency/seed/agents/
!data/agency/seed/agents/*.json

# Persona source pipeline (tools/persona/README.md): publisher downloads and
# intermediate normalized JSON are rebuilt locally, never committed
tools/persona/raw/
tools/persona/*.json
tools/onet_pdf_text/
