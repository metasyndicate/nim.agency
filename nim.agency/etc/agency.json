{
  "_": "NIM Agency source-controlled defaults. Checked into source and treated as read-only at runtime. Operator overrides are provided via CLI flags, not by mutating this file in place.",
  "dispatch": {
    "provider": "claude-cli",
    "max_concurrent": 2,
    "timeout_seconds": 600,
    "report_dir": "log"
  },
  "logging": {
    "dir": "~/.nim/agency",
    "dispatch_csv": "dispatch.log",
    "dispatch_json": "dispatch.json"
  },
  "economy": {
    "xp_per_task": 25,
    "gold_per_task": 10,
    "mission_bonus_xp": 15,
    "mission_bonus_gold": 5,
    "skill_points_per_rank": 10,
    "max_tool_proficiency": 3
  }
}
